name "asciitable"
description "A simple asciitable."
authors "Christian Koestlin"
copyright "Copyright (c) 2018, Christian Koestlin"
license "MIT"

x:ddoxFilterArgs "--min-protection=Private"
x:ddoxTool "scod"

dependency "colored" version="~>0.0.33"

configuration "library" {
  targetType "library"
  targetPath "out/lib"
  excludedSourceFiles "source/testsuite.d"
}

configuration "unittest" {
  targetType "executable"
  targetName "unittest"
  targetPath "out/test"

  dependency "unit-threaded" version="~>2.2.3"
  mainSourceFile "source/testsuite.d"
  postRunCommands "$DUB run lst2errormessages || true"
}
